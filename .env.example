# Copy of what the installer writes to .env (the installer fills in real values).
SECRET_KEY=change-me-64-random-characters
POSTGRES_PASSWORD=change-me
RUNNER_TOKEN=change-me
ELVIN_HOME_HOST=/absolute/path/to/Elvin
ELVIN_PORT=8765
ELVIN_BIND=127.0.0.1
ELVIN_UID=1000
ELVIN_GID=1000
BASE_URL=http://localhost:8765
HOST_HOME_HINT=~/Elvin
COMPOSE_FILE=docker-compose.yml

# Platform facts detected by the installer
HOST_OS=macos
HOST_ARCH=arm64
HOST_GPU=apple
HOST_GPU_NAME=Apple M-series
HOST_RAM_GB=16
HOST_VRAM_GB=0
HOST_COMPATIBLE=true

# Gemma 3 through your OpenAI-compatible gateway (leave GATEWAY_URL empty if you don't have one)
GATEWAY_URL=http://192.168.1.50:8000/v1
GATEWAY_API_KEY=your-gateway-key
GATEWAY_MODEL=gemma

# Local fallbacks in Docker (CPU, one loaded at a time; effort never above medium)
LOCAL_GEMMA_MODEL=gemma3:4b
LOCAL_QWEN_MODEL=qwen2.5-coder:3b
LOCAL_GEMMA_MEM=5g
# CPU threads for them: the start scripts use your performance cores (0 = let Ollama decide)
LOCAL_GEMMA_THREADS=0
# auto = gateway first, local Docker Gemma when it is down | local = local Docker Gemma only
GEMMA_SOURCE=auto

# Local Qwen Coder: vllm (NVIDIA/AMD) | ollama (Apple Silicon, AMD on Windows) | none
LOCAL_LLM_BACKEND=ollama
LOCAL_LLM_URL=http://host.docker.internal:11435
QWEN_MODEL=qwen2.5-coder:7b
QWEN_AUTOCOMPLETE_MODEL=qwen2.5-coder:1.5b-base

# Cloud models (required when this computer can't run Qwen locally)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: SMTP for password-reset email (otherwise links go to data/outbox/)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=elvin@localhost
CLAMAV_REQUIRED=true
LOADTEST_ALLOW_PUBLIC=false
